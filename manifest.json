{
  "manifest_version": 3,
  "name": "Supermarket Mode",
  "version": "0.2.0",
  "description": "Shop Amazon Fresh and Whole Foods like you're walking through a real supermarket: aisles, shelves, price tags, a cart and a shopping list.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Enter the supermarket",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://m.media-amazon.com/*",
    "https://images-na.ssl-images-amazon.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*"
      ],
      "js": [
        "src/vendor/three.min.js",
        "src/layout.js",
        "src/adapters/amazon.js",
        "src/adapters/demo.js",
        "src/ui.js",
        "src/walk3d.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/store.css"
      ],
      "matches": [
        "https://www.amazon.com/*"
      ]
    }
  ]
}
